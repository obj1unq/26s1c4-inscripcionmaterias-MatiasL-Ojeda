import estudiante.*
import materia.*
import carrera.*
import materiaAprobada.*
//    Descubri que veo el rojo y el amarillo igual, por lo que borre una banda de cosas de los test
// porque lo que yo veia todo rojo en realidad wollok solo me estaba diciendo que las materias, carreras
// y alumnos que estaba creando no lo estaba probando en ningun test.
// :´(  :´(   :´(

describe "name" {
    const elementosDeProgramacion = new Materia(nombre = "Programación", cupoMaximo = 2)
    const matematicas1  = new Materia(nombre = "Matemática", cupoMaximo = 1)

    const juan = new Estudiante(nombre = "Juan")
    test "Juan Aprobo" {
        const programacion = new Carrera(nombre = "Programacion", materias = #{elementosDeProgramacion, matematicas1})
        juan.aprobar(elementosDeProgramacion, 8)

        assert.equals(1, juan.cantMateriasAprobadas())
        assert.equals(8, juan.promedioNota())  
    }

    test "Promedi Juan" {
        juan.aprobar(elementosDeProgramacion, 10)
        juan.aprobar(matematicas1, 6)

        assert.equals(2, juan.cantMateriasAprobadas())
        assert.equals(8, juan.promedioNota())
    }

    const ana = new Estudiante(nombre = "Ana")

    test "Promedi Ana sin materias" {
        assert.equals(0, ana.promedioNota())
    }


    test "luis se inscribe en programacion" {
        const luis = new Estudiante(nombre = "Luis")
        const programacion = new Carrera(nombre = "Programacion", materias = #{elementosDeProgramacion, matematicas1})
        luis.carrerasEnCurso().add(programacion)
        luis.inscribirseEn(elementosDeProgramacion)

        assert.that(luis.estaInscripto(elementosDeProgramacion))
        assert.that(elementosDeProgramacion.inscriptos().contains(luis))
    }

    test "lista de espera cuando no hay cupo" {
        const programacion = new Carrera(nombre = "Programacion", materias = #{elementosDeProgramacion, matematicas1})
        const alumnoA = new Estudiante(nombre = "A")
        const alumnoB = new Estudiante(nombre = "B")

        alumnoA.carrerasEnCurso().add(programacion)
        alumnoB.carrerasEnCurso().add(programacion)
        alumnoA.inscribirseEn(matematicas1)
        alumnoB.inscribirseEn(matematicas1)

        assert.that(matematicas1.listaEspera().contains(alumnoB))
    }

    test "dar de baja y promover" {
        const alumnoA      = new Estudiante(nombre = "A")
        const alumnoB      = new Estudiante(nombre = "B")
        const programacion = new Carrera(nombre = "Programacion", materias = #{elementosDeProgramacion, matematicas1})
        
        alumnoA.carrerasEnCurso().add(programacion)
        alumnoB.carrerasEnCurso().add(programacion)
        alumnoA.inscribirseEn(matematicas1)
        alumnoB.inscribirseEn(matematicas1)

        matematicas1.darDeBaja(alumnoA)

        assert.that(matematicas1.inscriptos().contains(alumnoB))
    }

    test "puede inscribirse en materia" {
        const programacion = new Carrera(nombre = "Programacion", materias = #{elementosDeProgramacion, matematicas1})
        juan.carrerasEnCurso().add(programacion)
        assert.that(juan.puedeInscribirseEn(elementosDeProgramacion))
    }
}